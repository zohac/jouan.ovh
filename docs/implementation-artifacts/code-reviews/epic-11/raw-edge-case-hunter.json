    22	  return `Heure locale (${SITE.profile.city}) : ${hours.value}h${minutes.value}`;
    23	});
    24	
    25	function updateTime() {
    26	  const now = new Date();
    27	  const parts = new Intl.DateTimeFormat("en-GB", {
    28	    hour: "2-digit",
    29	    minute: "2-digit",
    30	    hour12: false,
    31	    timeZone: "Europe/Paris",
    32	  }).formatToParts(now);
    33	
    34	  const hourPart = parts.find((p) => p.type === "hour")?.value ?? "";
    35	  const minutePart = parts.find((p) => p.type === "minute")?.value ?? "";
    36	
    37	  hours.value = hourPart.padStart(2, "0");
    38	  minutes.value = minutePart.padStart(2, "0");
    39	  currentTimeIso.value = now.toISOString();
    40	}
    41	
    42	const interval: Ref<ReturnType<typeof setInterval> | null> = ref(null);
    43	
    44	onMounted(() => {
    45	  updateTime();
    46	  interval.value = setInterval(updateTime, 1000);
    47	});
    48	
    49	onUnmounted(() => {
    50	  if (interval.value !== null) {
    51	    clearInterval(interval.value);
    52	  }
    53	});
