   240	const isBootFinished = ref(false);
   241	const isReducedMotion = ref(false);
   242	let motionMq: MediaQueryList | null = null;
   243	
   244	function onMotionChange(e: MediaQueryListEvent) {
   245	  isReducedMotion.value = e.matches;
   246	}
   247	
   248	onMounted(() => {
   249	  motionMq = window.matchMedia("(prefers-reduced-motion: reduce)");
   250	  isReducedMotion.value = motionMq.matches;
   251	  motionMq.addEventListener("change", onMotionChange);
   252	});
   253	
   254	onBeforeUnmount(() => {
   255	  motionMq?.removeEventListener("change", onMotionChange);
   256	});
   257	
   258	function onBootComplete() {
   259	  isBootFinished.value = true;
   260	}
   260	}
   261	
   262	function onProjectMouseMove(event: MouseEvent) {
   263	  if (isReducedMotion.value) {
   264	    return;
   265	  }
   266	  if (typeof window !== "undefined" && window.matchMedia("(hover: none)").matches) {
   267	    return;
   268	  }
   269	  const target = event.currentTarget as HTMLElement | null;
   270	  if (!target) {
   271	    return;
   272	  }
   273	  const rect = target.getBoundingClientRect();
   274	  if (rect.width <= 0 || rect.height <= 0) {
   275	    return;
   276	  }
   277	  const px = (event.clientX - rect.left) / rect.width - 0.5;
   278	  const py = (event.clientY - rect.top) / rect.height - 0.5;
   279	  target.style.transform = `perspective(1000px) rotateX(${-py * 3.5}deg) rotateY(${px * 4.5}deg) translateY(-2px)`;
   280	}
   281	
   282	function onProjectMouseLeave(event: MouseEvent) {
   283	  const target = event.currentTarget as HTMLElement | null;
   284	  if (target) {
   285	    target.style.transform = "";
   286	  }
   287	}
