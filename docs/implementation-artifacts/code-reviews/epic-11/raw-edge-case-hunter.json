    95	<script lang="ts" setup>
    96	import type { ComponentPublicInstance } from "vue";
    97	import { onBeforeUnmount, onMounted, nextTick, ref } from "vue";
    98	import { NuxtLink } from "#components";
    99	import TerminalManagerComponent from "~/components/terminal/TerminalManagerComponent.vue";
   100	
   101	const route = useRoute();
   102	
   103	const navItems = [
   104	  { to: "/", label: "Accueil", prefix: "~" },
   105	  { to: "/services", label: "Services", prefix: "//" },
   106	  { to: "/about", label: "À propos", prefix: "./" },
   107	  { to: "/blog", label: "Blog", prefix: "~/" },
   108	  { to: "/contact", label: "Contact", prefix: "$" },
   109	];
   110	
   111	// Lien actif : exact pour l'accueil, préfixe pour les autres (couvre /blog/[...slug]).
   112	function isActive(to: string): boolean {
   113	  if (to === "/") {
   114	    return route.path === "/";
   115	  }
   116	  return route.path === to || route.path.startsWith(`${to}/`);
   117	}
   118	
   119	// --- Scroll state & progress ---
   120	const isScrolled = ref(false);
   121	const scrollProgress = ref(0);
   122	
   123	function onScroll() {
   124	  const top = window.scrollY || document.documentElement.scrollTop || 0;
   125	  isScrolled.value = top > 20;
   126	  const h = document.documentElement.scrollHeight - window.innerHeight;
   127	  const progress = h > 0 ? (top / h) * 100 : 0;
   128	  scrollProgress.value = Math.min(100, Math.max(0, progress));
   129	}
   130	
   131	// --- Terminal easter-egg (préservé) ---
   132	const terminalManager = ref<InstanceType<typeof TerminalManagerComponent> | null>(null);
   133	
   134	function addNewTerminal() {
   135	  terminalManager.value?.createNewTerminal();
   136	}
   137	
   138	// Expose l'ouverture du terminal au reste du site via le lanceur partagé
   139	// (ex. ligne « help » du hero d'accueil, story 3.1). Le gestionnaire reste
   140	// monté ici ; on enregistre seulement une référence vers sa méthode.
   141	const { register: registerTerminalLauncher, unregister: unregisterTerminalLauncher } = useTerminal();
   142	
   143	// --- Menu mobile accessible ---
   144	const menuOpen = ref(false);
   145	const firstMenuLink = ref<HTMLElement | null>(null);
   146	const burgerButton = ref<HTMLElement | null>(null);
   147	
   148	function registerFirstLink(el: Element | ComponentPublicInstance | null, index: number) {
   149	  if (index !== 0) {
   150	    return;
   151	  }
   152	  const instance = el as ComponentPublicInstance | null;
   153	  firstMenuLink.value = (instance?.$el ?? el) as HTMLElement | null;
   154	}
   155	
   156	function openMenu() {
   157	  menuOpen.value = true;
   158	  nextTick(() => firstMenuLink.value?.focus());
   159	}
   160	
   161	function closeMenu() {
   162	  menuOpen.value = false;
   163	}
   164	
   165	function onBrandClick(event: MouseEvent) {
   166	  closeMenu();
   167	  if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
   168	    return;
   169	  }
   170	  if (route.path === "/") {
   171	    event.preventDefault();
   172	    const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
   173	    window.scrollTo({ top: 0, behavior: isReducedMotion ? "auto" : "smooth" });
   174	  }
   175	}
   176	
   177	// Fermeture clavier/overlay : renvoie le focus au burger (déclencheur) — a11y.
   178	function closeMenuAndRefocus() {
   179	  if (!menuOpen.value) {
   180	    return;
   181	  }
   182	  closeMenu();
   183	  nextTick(() => burgerButton.value?.focus());
   184	}
   185	
   186	function toggleMenu() {
   187	  if (menuOpen.value) {
   188	    closeMenu();
   189	  } else {
   190	    openMenu();
   191	  }
   192	}
   193	
   194	function openTerminalFromMenu() {
   195	  addNewTerminal();
   196	  closeMenu();
   197	}
   198	
   199	function onKeydown(event: KeyboardEvent) {
   200	  if (event.key === "Escape" && menuOpen.value) {
   201	    closeMenuAndRefocus();
   202	  }
   203	}
   204	
   205	// Passage en desktop alors que le menu mobile est ouvert : on le ferme (sinon
   206	// l'overlay fixed resterait actif et le menu deviendrait incohérent au resize).
   207	let desktopMq: MediaQueryList | null = null;
   208	function onDesktopChange(event: MediaQueryListEvent) {
   209	  if (event.matches) {
   210	    closeMenu();
   211	  }
   212	}
   213	
   214	onMounted(() => {
   215	  document.addEventListener("keydown", onKeydown);
   216	  desktopMq = window.matchMedia("(min-width: 901px)");
   217	  desktopMq.addEventListener("change", onDesktopChange);
   218	  registerTerminalLauncher(addNewTerminal);
   219	  window.addEventListener("scroll", onScroll, { passive: true });
   220	  window.addEventListener("resize", onScroll, { passive: true });
   221	  onScroll();
   222	});
   223	
   224	onBeforeUnmount(() => {
   225	  document.removeEventListener("keydown", onKeydown);
   226	  desktopMq?.removeEventListener("change", onDesktopChange);
   227	  unregisterTerminalLauncher(addNewTerminal);
   228	  window.removeEventListener("scroll", onScroll);
   229	  window.removeEventListener("resize", onScroll);
   230	});
   231	</script>
