    10	import type { Ref } from "vue";
    11	import { computed, onMounted, onUnmounted, ref } from "vue";
    12	import { SITE } from "~/data/site";
    13	
    14	const hours = ref("--");
    15	const minutes = ref("--");
    16	const currentTimeIso = ref("");
    17	
    18	const timeAriaLabel = computed(() => {
    19	  if (hours.value === "--") {
    20	    return "Heure locale";
