      <input
        v-bind="controlAttrs"
        :id="fieldId"
        class="zinput"
        :class="{ 'zinput--has-icon': icon || $slots.icon }"
        :value="modelValue"
        :required="required || undefined"
        :aria-invalid="error || undefined"
        :aria-describedby="describedBy"
