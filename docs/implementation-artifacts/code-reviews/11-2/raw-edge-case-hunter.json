+];
+
+let stepTimeoutId: ReturnType<typeof setTimeout> | null = null;
+let dismissTimeoutId: ReturnType<typeof setTimeout> | null = null;
+
+function finishBoot() {
+  if (isDone.value) return;
+  isDone.value = true;
+  progressPercent.value = 100;
+
+  if (stepTimeoutId !== null) {
