+    }
+
+    const step = bootSteps[stepIndex];
+    if (step) {
+      currentStepText.value = step.text;
+      currentStepOk.value = step.ok;
+      progressPercent.value = Math.round(((stepIndex + 1) / bootSteps.length) * 100);
+    }
+    stepIndex++;
+    stepTimeoutId = setTimeout(next, 230);
+  }
+
+  next();
