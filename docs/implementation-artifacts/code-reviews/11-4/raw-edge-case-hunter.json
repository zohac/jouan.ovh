     3	// @nuxt/content v3 — déclaration explicite des collections (remplace l'auto-scan v2).
     4	// La collection blog reste vide tant qu'aucun article n'est ajouté sous content/blog/.
     5	export default defineContentConfig({
     6	  collections: {
     7	    blog: defineCollection({
     8	      type: "page",
     9	      source: "blog/**",
    10	      // type "page" fournit déjà title/description/path/body ; on type ici les champs
    11	      // additionnels consommés par la liste du blog (tri par date, tags, temps de lecture).
    12	      schema: z.object({
    13	        // Date ISO (YYYY-MM-DD) : tri lexicographique = tri chronologique, formatée en
    14	        // français à l'affichage. Sert au `.order("date", "DESC")`. Le `regex` fait
    15	        // échouer le build sur un format dévié (plutôt qu'un « Invalid Date » à l'écran
    16	        // et un tri faux).
    17	        date: z.string().regex(/^\d{4}-\d{2}-\d{2}$/, "date doit être au format ISO YYYY-MM-DD"),
    18	        // Tags (technos / sujets) rendus en ZTag.
    19	        tags: z.array(z.string()).default([]),
    20	        // Temps de lecture affiché dans la méta (ex. "8 min").
    21	        read: z.string().optional(),
    22	        // Vignette d'article (facultative).
    23	        image: z
    24	          .object({
    25	            src: z.string(),
    26	            alt: z.string(),
    27	          })
    28	          .optional(),
    29	      }),
    30	    }),
    31	  },
    32	});

