# Variables d'environnement — copier en `.env` (gitignoré) et renseigner.

# Clé d'accès Web3Forms pour l'envoi du formulaire de contact (/contact).
# Gratuite et instantanée : https://web3forms.com (saisir l'email de réception → clé envoyée).
# Sans cette clé, le formulaire affiche son état d'erreur (aucun envoi).
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
