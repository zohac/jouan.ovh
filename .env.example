# Variables d'environnement — copier en `.env` (gitignoré) et renseigner.

# Clé d'accès Web3Forms pour l'envoi du formulaire de contact (/contact).
# Gratuite et instantanée : https://web3forms.com (saisir l'email de réception → clé envoyée).
# Sans cette clé, le formulaire affiche son état d'erreur (aucun envoi).
NUXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Nuxt Site Config — source canonique du build SEO.
# L'URL doit être une origin http(s), sans chemin, query ni hash.
NUXT_SITE_URL=https://jouan.ovh
NUXT_SITE_NAME=jouan.ovh
# `development` bloque l'indexation localement. Le workflow CI force `production`.
NUXT_SITE_ENV=development

# AI Ready est piloté par `nuxt.config.ts` en mode build statique.
# Aucun secret MCP, WebMCP, runtime sync ou base distante n'est nécessaire.
# Node Docker doit être >= 22.13 pour le SQLite natif, ou utiliser better-sqlite3.

# PostHog EU — Analytics client & Session Replay
# Clé de projet publique (commence par phc_...) disponible dans PostHog > Project Settings
NUXT_PUBLIC_POSTHOG_KEY=
# Hôte d'ingestion européen PostHog Cloud (défaut : https://eu.i.posthog.com)
NUXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# PostHog MCP Server (optionnel pour outillage agent IA)
# Clé API personnelle avec preset "MCP Server" dans PostHog > User Settings > Personal API Keys
POSTHOG_API_KEY=
